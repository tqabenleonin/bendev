    "start": "node build/index.js",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@azure/msal-node": "^2.16.2",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.10"
  },
  "engines": {
    "node": ">=18"
  }
}
