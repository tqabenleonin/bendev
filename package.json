{
  "name": "flowagent",
  "version": "0.1.0",
  "description": "FlowAgent: an MCP server that exposes Microsoft Power Automate flow management as tools for MCP clients.",
  "type": "module",
  "bin": {
    "flowagent": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
