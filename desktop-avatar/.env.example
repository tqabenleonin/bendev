# GITHUB_TOKEN is optional — if unset, the orchestrator shells out to
# `gh auth token` and reuses whatever account you're logged into with the
# GitHub CLI. Set it explicitly only if you want a dedicated PAT instead.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
REPO_LOCAL_PATH=./repo
WORKTREE_BASE_DIR=./worktrees
DB_PATH=./orchestrator.db
POLL_INTERVAL_SECONDS=60
CLAUDE_CLI_PATH=claude
CODEX_CLI_PATH=codex
