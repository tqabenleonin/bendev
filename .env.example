# FlowAgent auth configuration - set ONE of the three modes below.

# Mode 1: pre-acquired bearer token (simplest; good for a quick test)
# e.g. `az account get-access-token --resource https://service.flow.microsoft.com/`
# POWER_AUTOMATE_ACCESS_TOKEN=

# Mode 2: service principal / client credentials
# POWER_AUTOMATE_TENANT_ID=
# POWER_AUTOMATE_CLIENT_ID=
# POWER_AUTOMATE_CLIENT_SECRET=

# Mode 3: interactive device-code login (CLIENT_ID optional, falls back to a
# well-known public client if omitted)
# POWER_AUTOMATE_TENANT_ID=

# Optional: default environment ID so tools don't need environmentId every call
# POWER_AUTOMATE_ENVIRONMENT_ID=
